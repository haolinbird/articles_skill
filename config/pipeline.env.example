# ============================================================
# 流水线共享配置模板（L1）
# 用法：cp config/pipeline.env.example config/pipeline.env，然后填入你自己的值
# ============================================================
# 本文件是模板，不含真实密钥，可以提交。
# 真实配置在 config/pipeline.env（含密钥，已在 .gitignore 排除，切勿提交）。
#
# 脚本（gzh_image_api.cjs / gzh_opener.cjs）会通过 scripts/load_config.cjs
# 自动向上查找并加载 config/pipeline.env，**不需要手动 source**。
# 优先级：命令行 --参数 > 进程环境变量 > config/pipeline.env
#
# 平台开关（启用哪些平台）不在本文件，在 config/platforms.json（L2）。
# ============================================================
# 本模板与当前实际通道（商汤 SenseNova）保持同步，最后校准 2026-10-12。
# ============================================================

# ---- Wechatsync（S6 分发）----
# 从 Chrome 扩展「文章同步助手」设置里启用 MCP 连接后获取
# ⚠️ 现行 CLI 一律需要 Token（与版本号无关，本机实测 v1.0.0 即需要）
WECHATSYNC_TOKEN=

# ---- 开篇人设图生成 API（S4-0，可选）----
# OpenAI images 兼容端点。两项均为空时 S4-0 自动跳过，不阻塞流水线。
# ⚠️ BASE_URL 不能带 /v1 后缀（gzh_opener.cjs 自己会拼 /v1/images/generations）
GZH_IMAGE_BASE_URL=https://token.sensenova.cn
GZH_IMAGE_API_KEY=
GZH_IMAGE_MODEL=sensenova-u1.5-lite

# ---- 正文配图 API（S4-1，替代 ImageGen 省积分）----
# ⚠️ 本段是配图的唯一配置入口，改这里即可，不用改 SKILL.md 或脚本
# 总开关：false = 整段跳过 S4，终稿不带图（降级，不阻塞流水线）
GZH_T2I_ENABLED=true
#
# 当前通道：商汤日日新 SenseNova U1.5 Lite（2026-10-12 从智谱 CogView-4 切来）
#   优势：中文文字零错字（智谱约半数写错）、watermark=false 可免费去水印、公测期免费（后续转付费）
#   控制台：https://platform.sensenova.cn （API Key 为 sk- 开头）
GZH_T2I_ENDPOINT=https://token.sensenova.cn/v1/images/generations
GZH_T2I_API_KEY=
GZH_T2I_MODEL=sensenova-u1.5-lite
#
# 协议：dashscope = 阿里原生（input.messages + parameters）；openai = {model,prompt,size,n}
GZH_T2I_PROTOCOL=openai
# ⚠️ 商汤必须显式传 false 才去水印（不传默认带水印）；脚本仅在非空时才下发该字段，
#    切到智谱/百炼等老通道时，把本项清空即可，不会误传。
GZH_T2I_WATERMARK=false
# 输出尺寸：16:9 横版（小黑配图模板的构图要求）。不支持时脚本自动回退 1024x576 → 512x288
# ⚠️ 商汤硬约束：宽高均须为 32 的倍数且在 512–4096（1024×576、512×288 均合规）
#    反面案例：1280x720 因 720 非 32 倍数会报 400 invalid size
GZH_T2I_SIZE=1024x576
# 下载后是否遮盖右下角水印：商汤已能服务端去水印，必须为 false，
# 否则会在「本来就没有水印」的图上盖一个多余矩形。
GZH_COVER_WATERMARK=false
# 每篇正文配图张数（拆上下篇时按篇计算）
GZH_IMAGES_PER_ARTICLE=2
# 并行生成数量：1 = 串行（逐张 + --delay 间隔）；>1 = 该并发度（按大小分桶，桶间仍保留间隔防限流）
GZH_T2I_CONCURRENCY=1
#
# ⚠️ 通道质量实测（各 4-6 张中文标注图）：
#   商汤 SenseNova U1.5 Lite：中文零错字、可去水印、公测免费 → 当前默认
#   智谱 CogView-4：中文错字率高（约半数写错，中英混合更差）；服务端强制水印需遮盖；0.06 元/张
#   百炼 qwen-image-2.0：中文全对、无水印、风格稳；0.2 元/张
# 切换通道时改 ENDPOINT / API_KEY / MODEL / PROTOCOL 四行，并核对两个 WATERMARK：
#   切回智谱 → 清空 GZH_T2I_WATERMARK（该项对其无效）并把 GZH_COVER_WATERMARK 改 true
#   切回百炼 → GZH_T2I_PROTOCOL=dashscope，GZH_COVER_WATERMARK 改 false

# ---- 篇幅与日产量上限 ----
# 单篇纯正文字数区间（剔除代码块与图片引用行后统计）
GZH_WORD_MIN=2000
GZH_WORD_MAX=4000
# 每天最多产出几篇公众号文章（硬上限：超字数只拆成上下两篇，不拆第三篇）
GZH_MAX_ARTICLES_PER_DAY=2

# ---- 开篇图默认参数（可选，也可命令行 --persona/--slogan 覆盖）----
#GZH_OPENER_PERSONA=1位黑发中年大叔
#GZH_OPENER_SLOGAN=一人公司
