# ── 密钥：含 Wechatsync Token 与图片通道 API Key，绝不能进版本库 ──
# 一旦提交，即使之后删除文件，历史提交里的明文依然可被检出。
config/pipeline.env
**/.env
!**/.env.example

# ── 系统与编辑器残留 ──
.DS_Store
.idea/
*.swp

# ── Python 编译缓存 ──
__pycache__/
*.pyc

# ── 运行日志 ──
logs/*.out
logs/*.err
logs/*.log

# dist是编译产物目录，不需要跟踪，可重复生成
dist/*

# ── 私有内容产物：本仓库公开分发（技能源码），文章/配图/素材不随包公开 ──
# 这三类都是每日运行产物，且含个人文章内容，公开仓库不保留。
# 注意：仅加入 .gitignore 不影响已提交的历史，历史清理见 .workbuddy/memory。
articles/
assets/
topics/

# ── 归档备份、个人语料、编辑器与工作区数据 ──
# .archive 曾含明文密钥备份（env-from-skill-dir），绝不可进版本库。
.archive/
wechat_exports/
.workbuddy/

# ── Node 依赖：npm install 安装，不进版本库；仓库只跟踪 package.json ──
node_modules/

